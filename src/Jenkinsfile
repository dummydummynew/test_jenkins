pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                bat 'mvn clean package'
            }
        }
        stage('Run') {
            steps {
                bat 'start /B java -jar target\\demo_jenkins-0.0.1-SNAPSHOT.jar --server.port=9090'
                sleep time: 10, unit: 'SECONDS'
            }
        }
    }
}
